# =========================================================================
# Hustlify B2B Assessment – Environment Variables
# =========================================================================

# 1. Google Sheets Integration (Optional but Recommended)
# Paste your deployed Google Apps Script Webhook URL below:
GOOGLE_SHEET_WEBHOOK_URL=""

# 2. Vercel Blob Audio Storage (For Production on Vercel)
# Automatically populated when you connect Vercel Blob in your Vercel Project Dashboard.
# In local development, if empty, audio is saved locally to /public/uploads.
BLOB_READ_WRITE_TOKEN=""

# 3. Built-in Admin Dashboard Passcode
# Access at /admin (default is admin123 if not set)
ADMIN_PASSWORD="admin123"

# 4. Telegram Alerts (Optional)
# Instant notification + playable voice messages on your phone!
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

